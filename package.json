    "deploy:commands": "node --env-file=.env dist/commandsRegistration/deploy.js",
    "lint": "tsc --noEmit && eslint --fix && prettier --write .",
    "lint:check": "tsc --noEmit && eslint",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "packageManager": "pnpm@12.3.0+sha512.d7bd39a488131de200aeec1dbc9ca58b890437f09b1f925b1bf820fdc463df01a329e3699c3d8a7bb186d5cf3f75cb68ce820c69d6b2c983525bc0821de4c529",
  "dependencies": {
    "discord.js": "^14.0.0",
    "mongodb": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-import": "^2.30.0",
    "lefthook": "^2.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.19.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.6.0"
  }
